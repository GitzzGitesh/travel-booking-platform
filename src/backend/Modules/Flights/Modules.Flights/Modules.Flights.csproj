<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <!-- Migrations tooling only (dotnet ef); never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The airport seed dataset (IAirportDirectory), loaded once at startup. -->
    <EmbeddedResource Include="Infrastructure/ReferenceData/airports.json" LogicalName="TravelBooking.Modules.Flights.Infrastructure.ReferenceData.airports.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modules.Flights.UnitTests" />
    <InternalsVisibleTo Include="Modules.Flights.IntegrationTests" />
    <InternalsVisibleTo Include="Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\BuildingBlocks.csproj" />
    <ProjectReference Include="..\Modules.Flights.Contracts\Modules.Flights.Contracts.csproj" />
  </ItemGroup>

</Project>
