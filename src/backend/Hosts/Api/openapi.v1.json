{
  "openapi": "3.1.1",
  "info": {
    "title": "Travel Booking API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/flights/searches": {
      "post": {
        "tags": [
          "Flights"
        ],
        "operationId": "SearchFlights",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flights/selected-offers": {
      "post": {
        "tags": [
          "Flights"
        ],
        "operationId": "SelectFlightOffer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectFlightOfferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedFlightOfferResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedFlightOfferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flights/selected-offers/{selectedOfferId}/revalidations": {
      "post": {
        "tags": [
          "Flights"
        ],
        "operationId": "RevalidateSelectedFlightOffer",
        "parameters": [
          {
            "name": "selectedOfferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmedFlightOfferResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedOfferProblemResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/flights/selected-offers/{selectedOfferId}/price-acceptances": {
      "post": {
        "tags": [
          "Flights"
        ],
        "operationId": "AcceptSelectedFlightOfferPrice",
        "parameters": [
          {
            "name": "selectedOfferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptFlightOfferPriceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmedFlightOfferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectedOfferProblemResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptFlightOfferPriceRequest": {
        "required": [
          "priceQuoteId"
        ],
        "type": "object",
        "properties": {
          "priceQuoteId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "CabinClass": {
        "enum": [
          "Economy",
          "PremiumEconomy",
          "Business",
          "First"
        ]
      },
      "ConfirmedFlightOfferResponse": {
        "required": [
          "selectedOfferId",
          "totalPrice",
          "selectedTotalPrice",
          "offerExpiresAt",
          "revalidatedAt"
        ],
        "type": "object",
        "properties": {
          "selectedOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "totalPrice": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "selectedTotalPrice": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "offerExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "revalidatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FlightOfferResponse": {
        "required": [
          "offerId",
          "totalPrice",
          "expiresAt",
          "slices"
        ],
        "type": "object",
        "properties": {
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "totalPrice": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "slices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightSliceResponse"
            }
          }
        }
      },
      "FlightSearchRequest": {
        "required": [
          "origin",
          "destination",
          "departureDate"
        ],
        "type": "object",
        "properties": {
          "origin": {
            "pattern": "^[A-Z]{3}$",
            "type": [
              "null",
              "string"
            ]
          },
          "destination": {
            "pattern": "^[A-Z]{3}$",
            "type": [
              "null",
              "string"
            ]
          },
          "departureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "returnDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "adults": {
            "maximum": 9,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "children": {
            "maximum": 8,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "infants": {
            "maximum": 9,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "cabin": {
            "$ref": "#/components/schemas/CabinClass"
          }
        }
      },
      "FlightSearchResponse": {
        "required": [
          "searchId",
          "offers"
        ],
        "type": "object",
        "properties": {
          "searchId": {
            "type": "string",
            "format": "uuid"
          },
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightOfferResponse"
            }
          }
        }
      },
      "FlightSegmentResponse": {
        "required": [
          "marketingCarrier",
          "flightNumber",
          "origin",
          "destination",
          "departureLocal",
          "arrivalLocal"
        ],
        "type": "object",
        "properties": {
          "marketingCarrier": {
            "type": "string"
          },
          "flightNumber": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "departureLocal": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalLocal": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FlightSliceResponse": {
        "required": [
          "segments"
        ],
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightSegmentResponse"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MoneyResponse": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SelectedFlightOfferResponse": {
        "required": [
          "selectedOfferId",
          "searchId",
          "offerId",
          "totalPrice",
          "offerExpiresAt",
          "slices"
        ],
        "type": "object",
        "properties": {
          "selectedOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "searchId": {
            "type": "string",
            "format": "uuid"
          },
          "offerId": {
            "type": "string",
            "format": "uuid"
          },
          "totalPrice": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "offerExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "slices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightSliceResponse"
            }
          }
        }
      },
      "SelectedOfferProblemResponse": {
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "selectedOfferId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "previousTotalPrice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyResponse"
              }
            ]
          },
          "newTotalPrice": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MoneyResponse"
              }
            ]
          },
          "priceQuoteId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "offerExpiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "requiresConfirmation": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "SelectFlightOfferRequest": {
        "required": [
          "searchId",
          "offerId"
        ],
        "type": "object",
        "properties": {
          "searchId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "offerId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Flights"
    }
  ]
}
