{
  "openapi": "3.1.1",
  "info": {
    "title": "Travel Booking API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/flights/searches": {
      "post": {
        "tags": [
          "Flights"
        ],
        "operationId": "SearchFlights",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CabinClass": {
        "enum": [
          "Economy",
          "PremiumEconomy",
          "Business",
          "First"
        ]
      },
      "FlightOfferResponse": {
        "required": [
          "totalPrice",
          "expiresAt",
          "slices"
        ],
        "type": "object",
        "properties": {
          "totalPrice": {
            "$ref": "#/components/schemas/MoneyResponse"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "slices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightSliceResponse"
            }
          }
        }
      },
      "FlightSearchRequest": {
        "required": [
          "origin",
          "destination",
          "departureDate"
        ],
        "type": "object",
        "properties": {
          "origin": {
            "pattern": "^[A-Z]{3}$",
            "type": [
              "null",
              "string"
            ]
          },
          "destination": {
            "pattern": "^[A-Z]{3}$",
            "type": [
              "null",
              "string"
            ]
          },
          "departureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "returnDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "adults": {
            "maximum": 9,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "children": {
            "maximum": 8,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "infants": {
            "maximum": 9,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "cabin": {
            "$ref": "#/components/schemas/CabinClass"
          }
        }
      },
      "FlightSearchResponse": {
        "required": [
          "offers"
        ],
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightOfferResponse"
            }
          }
        }
      },
      "FlightSegmentResponse": {
        "required": [
          "marketingCarrier",
          "flightNumber",
          "origin",
          "destination",
          "departureLocal",
          "arrivalLocal"
        ],
        "type": "object",
        "properties": {
          "marketingCarrier": {
            "type": "string"
          },
          "flightNumber": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "departureLocal": {
            "type": "string",
            "format": "date-time"
          },
          "arrivalLocal": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FlightSliceResponse": {
        "required": [
          "segments"
        ],
        "type": "object",
        "properties": {
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlightSegmentResponse"
            }
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "MoneyResponse": {
        "required": [
          "amount",
          "currency"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Flights"
    }
  ]
}
