              "string"
            ]
          },
          "bookingReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "ticketing": {
            "type": [
              "null",
              "string"
            ]
          },
          "bookingStartedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AdminOrderPage": {
        "required": [
          "orders",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
