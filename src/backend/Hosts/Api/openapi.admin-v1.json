          "selectedOfferId",
          "status",
          "agreedPrice",
          "providerId",
          "bookingReference",
          "ticketing",
          "bookingStartedAt"
        ],
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "agreedPrice": {
