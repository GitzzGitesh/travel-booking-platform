<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deterministic, scenario-driven payment provider for development and tests only (ADR 0004). Runs only in Development or Staging. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The mock's own payment state, shared by the Api and the Worker (ADR 0032): schema paymentsmock. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- Migrations tooling only (dotnet ef); never flows to consumers. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProviderContracts" />
    <InternalsVisibleTo Include="Api.IntegrationTests" />
    <InternalsVisibleTo Include="ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Modules\Payments\Modules.Payments\Modules.Payments.csproj" />
  </ItemGroup>

</Project>
